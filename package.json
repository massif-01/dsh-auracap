{
  "name": "dsh-auracap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capture screenshots from your phone or clipboard into DeepSeek Harness, and let the model turn them into searchable fragments.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "prompts/*.md",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.jpg",
    "assets/*.png",
    "assets/*.plist",
    "assets/fonts/*"
  ],
  "icon": "./assets/icon.png",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
